# Private to the project (R2, M42). AGENTS.md, CLAUDE.md and the five core documents in
# project_docs/ are published. The assessment PDF in docs/ and the other files in project_docs/
# stay local.
docs/
project_docs/*
!project_docs/intent.md
!project_docs/spec.md
!project_docs/plan.md
!project_docs/algorithm_research.md
!project_docs/assumptions_made.md
.claude/

# Environment and tool caches
.venv/
__pycache__/
*.egg-info/
.hypothesis/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Generated inputs and run data. The final results are published: the sample run, statistics,
# logs, reports, charts and the presentation. The saved runs in runs/ and their manifest only let
# an interrupted suite carry on, and `generate --suite` reproduces the inputs, so they stay local,
# as do other runs' folders.
data/generated/
results/*
!results/final_presentation.pdf
!results/sample/
!results/*.csv
!results/report.md
!results/by_config/
!results/charts/
!results/samples/
!results/cases/
!results/express/
results/cases/*
results/express/*
!results/cases/*.csv
!results/cases/report.md
!results/cases/by_config/
!results/cases/charts/
!results/cases/samples/
!results/express/*.csv
!results/express/report.md
!results/express/by_config/
!results/express/charts/
!results/express/samples/
